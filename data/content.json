  "snapshots": [
    {
      "key": "375",
      "from": "375",
      "to": "474",
      "elementary": {
        "caption": "4세기, 백제가 가장 힘이 셌어요",
        "summary": "4세기 후반에는 백제가 가장 힘이 셌어요. 근초고왕은 남쪽 마한 땅을 대부분 차지했어요. 5세기 초에는 고구려 광개토 대왕이 땅을 크게 넓혔어요.",
        "events": [
          {
            "year": "384",
            "text": "백제가 불교를 받아들였어요."
          },
          {
            "year": "391",
            "text": "고구려에서 광개토 대왕이 왕이 되었어요."
          },
          {
            "year": "400",
            "text": "광개토 대왕이 신라를 도와 왜를 물리쳤어요."
          },
          {
            "year": "414",
            "text": "장수왕이 광개토 대왕릉비를 세웠어요."
          },
          {
            "year": "427",
            "text": "장수왕이 도읍을 평양으로 옮겼어요."
          }
        ],
        "questions": [
          "백제가 바다와 가까운 땅을 많이 차지하면 어떤 점이 좋았을까요?",
          "광개토 대왕은 왜 신라를 도왔을까요?"
        ]
      },
      "middle": {
        "caption": "4세기 백제의 전성기와 고구려의 체제 정비",
        "summary": "4세기 후반 백제 근초고왕은 마한의 남은 세력을 통합하고 고구려를 공격해 황해도 지역까지 세력을 넓혔다. 같은 무렵 고구려 소수림왕은 불교를 받아들이고 태학을 세우며 율령을 반포해 나라의 체제를 정비했다. 이를 바탕으로 광개토 대왕은 5세기 초 요동을 차지하고 한강 북쪽까지 영토를 넓혔다.",
        "events": [
          {
            "year": "384",
            "text": "백제가 동진에서 온 승려를 통해 불교를 받아들였다."
          },
          {
            "year": "396",
            "text": "광개토 대왕이 백제를 공격해 한강 북쪽 일부를 차지했다."
          },
          {
            "year": "400",
            "text": "광개토 대왕이 신라에 군대를 보내 신라를 침략한 왜를 물리쳤다."
          },
          {
            "year": "414",
            "text": "장수왕이 아버지의 업적을 새긴 광개토 대왕릉비를 세웠다."
          },
          {
            "year": "427",
            "text": "장수왕이 도읍을 국내성에서 평양으로 옮기고 남쪽으로 세력을 넓히려 했다."
          }
        ],
        "questions": [
          "고구려가 도읍을 평양으로 옮긴 일은 백제와 신라에 어떤 영향을 주었을까?",
          "4세기 백제와 5세기 고구려가 세력을 넓힌 방향을 지도에서 비교해 보자."
        ]
      }
    },
